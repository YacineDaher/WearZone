@model WearZone.Areas.Admin.Controllers.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Customer Details";
}

<div style="margin-bottom: 20px;">
    <a href="/Admin/Customers" class="btn-admin btn-admin-secondary" style="display: inline-flex; align-items: center; gap: 8px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Customers
    </a>
</div>

<div style="display: grid; grid-template-columns: 300px 1fr; gap: 30px;">
    <!-- Profile Card -->
    <div style="background: #fff; border: 1px solid var(--admin-border); border-radius: 8px; padding: 30px;">
        <div style="text-align: center; margin-bottom: 20px;">
            <div style="width: 80px; height: 80px; background: var(--bg-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 600; color: var(--text-secondary); margin: 0 auto 15px;">
                @((Model.User.FirstName?.FirstOrDefault() ?? '?').ToString().ToUpper())
            </div>
            <h2 style="font-size: 18px; margin: 0;">@Model.User.FirstName @Model.User.LastName</h2>
            <p style="color: #666; margin: 5px 0 0;">Customer</p>
        </div>
        
        <div style="border-top: 1px solid #eee; padding-top: 20px; margin-top: 20px;">
            <div style="margin-bottom: 15px;">
                <label style="display: block; font-size: 11px; text-transform: uppercase; color: #999; margin-bottom: 5px; font-weight: 600;">Email</label>
                <div>@Model.User.Email</div>
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; font-size: 11px; text-transform: uppercase; color: #999; margin-bottom: 5px; font-weight: 600;">Member Since</label>
                <div>@Model.User.RegisteredAt.ToString("MMMM dd, yyyy")</div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; background: #f9fafb; padding: 15px; border-radius: 6px;">
                <div style="text-align: center;">
                    <div style="font-size: 18px; font-weight: 700;">@Model.OrderCount</div>
                    <div style="font-size: 11px; color: #666;">Orders</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 18px; font-weight: 700;">$@Model.TotalSpent.ToString("0.##")</div>
                    <div style="font-size: 11px; color: #666;">Spent</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Activity Feed -->
    <div style="display: flex; flex-direction: column; gap: 30px;">
        
        <!-- Orders -->
        <div style="background: #fff; border: 1px solid var(--admin-border); border-radius: 8px; padding: 30px;">
            <h3 style="margin-top: 0; margin-bottom: 25px; font-size: 16px; text-transform: uppercase; letter-spacing: 1px;">Recent Orders</h3>
            
            @if (Model.Orders.Any())
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case "Pending":
                                            <span class="badge badge-warning">Pending</span>
                                            break;
                                        case "Shipped":
                                            <span class="badge badge-info">Shipped</span>
                                            break;
                                        case "Delivered":
                                            <span class="badge badge-success">Delivered</span>
                                            break;
                                        default:
                                            <span class="badge badge-secondary">@order.Status</span>
                                            break;
                                    }
                                </td>
                                <td>$@order.TotalAmount.ToString("N2")</td>
                                <td><a href="/Admin/Orders/Details/@order.Id" style="color: var(--primary-color);">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: #999; font-style: italic;">No orders placed yet.</p>
            }
        </div>
        
        <!-- Wishlist -->
        <div style="background: #fff; border: 1px solid var(--admin-border); border-radius: 8px; padding: 30px;">
            <h3 style="margin-top: 0; margin-bottom: 25px; font-size: 16px; text-transform: uppercase; letter-spacing: 1px;">Wishlist Items</h3>
            
            @if (Model.WishlistItems.Any())
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
                    @foreach (var item in Model.WishlistItems)
                    {
                        <div style="border: 1px solid #eee; border-radius: 6px; overflow: hidden;">
                            <img src="@item.Product.ImageUrl" style="width: 100%; height: 150px; object-fit: cover;" />
                            <div style="padding: 10px;">
                                <div style="font-weight: 600; font-size: 13px; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Product.Name</div>
                                <div style="font-size: 12px; color: #666;">$@item.Product.Price.ToString("N2")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color: #999; font-style: italic;">No items in wishlist.</p>
            }
        </div>
    </div>
</div>
