@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products Management";
}

<!-- Header Actions -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <div></div>
    <a href="/Admin/Products/Create" class="btn-admin btn-admin-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add New Product
    </a>
</div>

<!-- Filters -->
<div class="admin-filters">
    <div class="admin-filter-group">
        <label class="admin-form-label">Search</label>
        <input type="text" id="searchTerm" class="admin-form-input" placeholder="Product name or SKU..." value="@Context.Request.Query["searchTerm"]" />
    </div>
    
    <div class="admin-filter-group">
        <label class="admin-form-label">Category</label>
        <select id="category" class="admin-form-select">
            <option value="">All Categories</option>
            @foreach (var cat in ViewBag.Categories as List<Category>)
            {
                <option value="@cat.Name" selected="@(Context.Request.Query["category"] == cat.Name)">@cat.Name</option>
            }
        </select>
    </div>
    
    <div class="admin-filter-group">
        <label class="admin-form-label">Gender</label>
        <select id="gender" class="admin-form-select">
            <option value="">All</option>
            <option value="Men" selected="@(Context.Request.Query["gender"] == "Men")">Men</option>
            <option value="Women" selected="@(Context.Request.Query["gender"] == "Women")">Women</option>
            <option value="Kids" selected="@(Context.Request.Query["gender"] == "Kids")">Kids</option>
            <option value="Unisex" selected="@(Context.Request.Query["gender"] == "Unisex")">Unisex</option>
        </select>
    </div>
    
    <div class="admin-filter-group">
        <label class="admin-form-label">Status</label>
        <select id="isActive" class="admin-form-select">
            <option value="">All</option>
            <option value="true" selected="@(Context.Request.Query["isActive"] == "true")">Active</option>
            <option value="false" selected="@(Context.Request.Query["isActive"] == "false")">Inactive</option>
        </select>
    </div>
    
    <div class="admin-filter-group">
        <button onclick="applyFilters()" class="btn-admin btn-admin-primary" style="width: 100%;">Apply Filters</button>
    </div>
</div>

<!-- Products Table -->
<div class="admin-table-container">
    <div class="admin-table-header">
        <h3 class="admin-table-title">All Products (@Model.Count())</h3>
    </div>
    
    @if (Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <img src="@product.ImageUrl" alt="@product.Name" class="product-img-sm" />
                                <div>
                                    <div><strong>@product.Name</strong></div>
                                    <div style="font-size: 12px; color: #999;">@product.Brand</div>
                                </div>
                            </div>
                        </td>
                        <td><code>@product.SKU</code></td>
                        <td>@product.Category?.Name</td>
                        <td><strong>$@product.Price.ToString("N2")</strong></td>
                        <td>
                            @if (product.StockQuantity == 0)
                            {
                                <span class="badge badge-danger">Out of Stock</span>
                            }
                            else if (product.StockQuantity < 10)
                            {
                                <span class="badge badge-warning">@product.StockQuantity units</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@product.StockQuantity units</span>
                            }
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px;">
                                <a href="/Admin/Products/Edit/@product.Id" class="btn-admin btn-admin-secondary btn-admin-sm">Edit</a>
                                <button onclick="toggleActive(@product.Id, @product.IsActive.ToString().ToLower())" class="btn-admin btn-admin-secondary btn-admin-sm">
                                    @(product.IsActive ? "Deactivate" : "Activate")
                                </button>
                                <form method="post" action="/Admin/Products/Delete/@product.Id" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding: 60px 20px; text-align: center; color: #999;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="margin-bottom: 20px; opacity: 0.3;">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
            <h3>No products found</h3>
            <p>Try adjusting your filters or add a new product</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function applyFilters() {
            const searchTerm = document.getElementById('searchTerm').value;
            const category = document.getElementById('category').value;
            const gender = document.getElementById('gender').value;
            const isActive = document.getElementById('isActive').value;
            
            let url = '/Admin/Products?';
            if (searchTerm) url += `searchTerm=${encodeURIComponent(searchTerm)}&`;
            if (category) url += `category=${encodeURIComponent(category)}&`;
            if (gender) url += `gender=${encodeURIComponent(gender)}&`;
            if (isActive) url += `isActive=${isActive}&`;
            
            window.location.href = url;
        }

        async function toggleActive(productId, currentStatus) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch(`/Admin/Products/ToggleActive/${productId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });

                const result = await response.json();
                if (result.success) {
                    location.reload();
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Failed to update product status');
            }
        }

        // Allow Enter key to apply filters
        document.getElementById('searchTerm').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                applyFilters();
            }
        });
    </script>
}
