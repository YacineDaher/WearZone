@page
@model WearZone.Pages.AboutModel
@{
    ViewData["Title"] = "Our Story";
}

<div class="about-page">
    
    <!-- Hero / Intro -->
    <section class="about-hero">
        <div class="about-hero-content">
            <h1 class="about-title">Redefining Modern<br>Luxury Essentials</h1>
            <p class="about-lead">Founded in 2026, WearZone was born from a desire to create a wardrobe that transcends seasons. We believe in the power of simplicity, quality, and timeless design.</p>
        </div>
    </section>

    <!-- Image Break -->
    <div class="about-image-full">
        <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?q=80&w=2070&auto=format&fit=crop" alt="WearZone Studio" />
    </div>

    <!-- Mission -->
    <section class="about-section">
        <div class="about-grid">
            <div class="about-col-text">
                <span class="sub-label">The Mission</span>
                <h2>Conscious Design<br>For The Future</h2>
                <p>We are committed to slowing down the fashion cycle. Our collections are designed to last, using premium materials and ethical manufacturing processes. We don't chase trends; we create pieces that you will cherish for years.</p>
            </div>
            <div class="about-col-image">
                <img src="https://images.unsplash.com/photo-1558769132-cb1aea458c5e?q=80&w=1974&auto=format&fit=crop" alt="Fabric Detail" />
            </div>
        </div>
    </section>

    <!-- Values -->
    <section class="values-section">
        <div class="values-grid">
            <div class="value-item">
                <h3>01. Quality</h3>
                <p>Meticulous attention to detail in every stitch. We source the finest fabrics to ensure durability and comfort.</p>
            </div>
            <div class="value-item">
                <h3>02. Sustainability</h3>
                <p>Responsible production is at our core. We strive to minimize our footprint and support fair labor practices.</p>
            </div>
            <div class="value-item">
                <h3>03. Simplicity</h3>
                <p>We strip away the unnecessary. Our designs are clean, functional, and effortlessly stylish.</p>
            </div>
        </div>
    </section>

</div>
